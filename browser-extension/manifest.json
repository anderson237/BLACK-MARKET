{
  "manifest_version": 3,
  "name": "DeepRoots Import — Scraper fournisseurs",
  "version": "0.1.0",
  "description": "Capture le produit ouvert sur Taobao / Tmall / 1688 / Amazon / Goofish / Douyin / TikTok et l'envoie au pipeline d'import DeepRoots (ST-020). Usage admin solo.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.1688.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.de/*",
    "https://*.amazon.it/*",
    "https://*.amazon.es/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.co.jp/*",
    "https://*.amazon.com.br/*",
    "https://*.amazon.in/*",
    "https://*.amazon.com.mx/*",
    "https://*.amazon.com.au/*",
    "https://*.amazon.nl/*",
    "https://*.amazon.se/*",
    "https://*.amazon.pl/*",
    "https://*.amazon.ae/*",
    "https://*.amazon.com.tr/*",
    "https://*.goofish.com/*",
    "https://*.douyin.com/*",
    "https://*.tiktok.com/*",
    "https://deeproots-importexport.netlify.app/*"
  ],
  "action": {
    "default_title": "DeepRoots — Importer ce produit",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.1688.com/*",
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.de/*",
        "https://*.amazon.it/*",
        "https://*.amazon.es/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.co.jp/*",
        "https://*.amazon.com.br/*",
        "https://*.amazon.in/*",
        "https://*.amazon.com.mx/*",
        "https://*.amazon.com.au/*",
        "https://*.amazon.nl/*",
        "https://*.amazon.se/*",
        "https://*.amazon.pl/*",
        "https://*.amazon.ae/*",
        "https://*.amazon.com.tr/*",
        "https://*.goofish.com/*",
        "https://*.douyin.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.1688.com/*",
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.de/*",
        "https://*.amazon.it/*",
        "https://*.amazon.es/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.co.jp/*",
        "https://*.amazon.com.br/*",
        "https://*.amazon.in/*",
        "https://*.amazon.com.mx/*",
        "https://*.amazon.com.au/*",
        "https://*.amazon.nl/*",
        "https://*.amazon.se/*",
        "https://*.amazon.pl/*",
        "https://*.amazon.ae/*",
        "https://*.amazon.com.tr/*",
        "https://*.goofish.com/*",
        "https://*.douyin.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}