# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_PASSWORD: Admin console password (defaults to "ADMIN99" for demo).
# SECURITY: define a strong custom password before going to production.
ADMIN_PASSWORD="MY_STRONG_ADMIN_PASSWORD"

# GEMINI_MODEL: Model used for translation/copywriting (supports responseSchema).
GEMINI_MODEL="gemini-2.5-flash"

# GEMINI_FALLBACK_MODEL: Fallback model used when the primary is unavailable.
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"

# PORT: HTTP port for the server (default 3000).
PORT=3000

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"
