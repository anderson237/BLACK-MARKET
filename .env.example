# ===========================================================================
# BLACK MARKET — SINO-PREP Console — Variables d'environnement
# Copiez ce fichier en `.env` et remplissez les valeurs réelles.
# Ne COMMITTEZ JAMAIS le fichier `.env` (il est déjà ignoré par .gitignore).
# ===========================================================================

# GEMINI_API_KEY: Requise pour l'API Gemini (traduction / copywriting / prix).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_PASSWORD: Clé d'accès de la console admin.
# SECURITE: NE PAS laisser la valeur de démo par défaut. Définissez un mot de
# passe fort (>= 16 caractères, mélange majuscules/minuscules/chiffres/symboles)
# AVANT toute mise en production. Un avertissement est loggé au démarrage si
# cette variable est absente (la valeur de repli 'ADMIN99' est alors active).
ADMIN_PASSWORD="MY_STRONG_ADMIN_PASSWORD"

# ADMIN_EMAILS: liste blanche d'emails autorisés pour le login Google,
# séparés par des virgules. (Ancienne variable ADMIN_EMAIL acceptée aussi.)
ADMIN_EMAILS="elomopatrick.pn@gmail.com"

# GOOGLE_CLIENT_ID: Client ID OAuth 2.0 Google (nécessaire pour "Sign in with Google").
GOOGLE_CLIENT_ID="809279866832-16p4nguhc37v46tqtcnte0e39ss1atf2.apps.googleusercontent.com"

# GEMINI_MODEL: Modèle utilisé pour la traduction/copywriting (supporte responseSchema).
GEMINI_MODEL="gemini-2.5-flash"

# GEMINI_FALLBACK_MODEL: Modèle de repli quand le principal est indisponible.
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"

# PORT: Port HTTP pour le serveur local (défaut 3000).
PORT=3000

# APP_URL: URL publique du site (liens auto-référentiels et API).
APP_URL="https://deeproots-importexport.netlify.app"

# NETLIFY_SITE_ID: ID du site Netlify (utile en dehors du runtime Netlify
# pour getStore — en production sur Netlify il est auto-injecté par connectLambda).
NETLIFY_SITE_ID=""

# NETLIFY_ACCESS_TOKEN: Token d'accès Netlify (optionnel, réservé à l'usage
# hors runtime Netlify). Ne jamais committer ce token.
NETLIFY_ACCESS_TOKEN=""
